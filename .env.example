# Backend (copy to backend/.env)
APP_NAME=Email Threat Detection Platform
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=email_threat_intel

# JWT will be used in a later step
# JWT_SECRET=replace-me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend (optional; Vite reads VITE_* from frontend/.env)
# VITE_API_BASE_URL=/api/v1

# Phase 4 passive infrastructure enrichment (disabled by default)
PASSIVE_INTEL_ENABLED=false
PASSIVE_INTEL_PROVIDER=rdap
PASSIVE_INTEL_TIMEOUT_SECONDS=3
PASSIVE_INTEL_MAX_LOOKUPS=20
IPAPI_IS_API_KEY=

# Phase 7 report access (disabled by default for local development)
REPORT_AUTH_REQUIRED=false
JWT_SECRET_KEY=development-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEMO_USERNAME=analyst
DEMO_PASSWORD=change-me
